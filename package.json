{
  "name": "projet-avenir",
  "version": "1.0.0",
  "private": true,
  "description": "Projet AVENIR (Rikolto RDC) - Boîte à outils interactive et simulateur économique agricole",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "build:shared": "npm run build --workspace=@avenir/shared",
    "db:push": "npm run db:push --workspace=@avenir/api",
    "db:seed": "npm run db:seed --workspace=@avenir/api",
    "openapi:generate": "npm run openapi:generate --workspace=@avenir/api",
    "api:codegen": "npm run codegen --workspace=@avenir/web",
    "dev:api": "npm run dev --workspace=@avenir/api",
    "dev:web": "npm run dev --workspace=@avenir/web"
  }
}

